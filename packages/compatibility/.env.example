# Copy to a private env file and fill every required value explicitly.
COMPAT_MODE=protocol-fixture
COMPAT_DATABASE_URL=postgresql://compat:compat-test-only@127.0.0.1:55432/oh_bot_compat
COMPAT_HISTORY_PATH=/absolute/path/to/oh-bot/packages/compatibility/.state/memory-history.sqlite

# Required even in fixture mode so configuration is explicit. Fixture mode replaces only base URLs.
COMPAT_CHAT_BASE_URL=
COMPAT_CHAT_API_KEY=
COMPAT_CHAT_MODEL=
COMPAT_EMBEDDING_BASE_URL=
COMPAT_EMBEDDING_API_KEY=
COMPAT_EMBEDDING_MODEL=
COMPAT_EMBEDDING_DIMENSIONS=
